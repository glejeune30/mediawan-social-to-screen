# Copy this file to .env and fill in your own keys. Never commit .env.
# YouTube Data API v3: console.cloud.google.com > APIs & Services > enable "YouTube Data API v3" > Credentials > API key
YOUTUBE_API_KEY=
# Reddit: reddit.com/prefs/apps > "create another app" > type "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=mediawan-radar/0.1 by <your_reddit_username>
# NYT Books API: developer.nytimes.com > create an app > enable Books API
NYT_API_KEY=
